{
    "name": "@tailwind-merge/vite",
    "version": "0.0.0",
    "private": true,
    "description": "Vite plugin that generates a project-optimized twMerge from the project's Tailwind CSS. Prototype, see ../configurator/PROPOSAL.md §11.",
    "license": "MIT",
    "author": "Dany Castillo",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./runtime": "./src/runtime.ts",
        "./tailwind-merge": "./src/tailwind-merge.ts"
    },
    "scripts": {
        "lint": "eslint --max-warnings 0 .",
        "test": "vitest --no-watch",
        "test:watch": "vitest",
        "test:types": "tsc --noEmit",
        "version": "node ../../scripts/update-pinned-links.mjs"
    },
    "peerDependencies": {
        "@tailwindcss/vite": "~4.3.3",
        "tailwindcss": "~4.3.3",
        "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
    },
    "peerDependenciesMeta": {
        "@tailwindcss/vite": {
            "optional": true
        }
    },
    "dependencies": {
        "@tailwindcss/node": "~4.3.3",
        "tailwind-merge": "workspace:*",
        "tailwind-merge-configurator": "workspace:*"
    },
    "devDependencies": {
        "@tailwindcss/vite": "~4.3.3",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "tailwindcss": "~4.3.3",
        "typescript": "catalog:",
        "vite": "^7.3.3",
        "vitest": "catalog:"
    }
}
