{
    "name": "@tailwind-merge/vite",
    "version": "0.0.0",
    "private": true,
    "description": "Vite plugin that generates a project-optimized twMerge from the project's Tailwind CSS. Prototype, see ../configurator/PROPOSAL.md §11.",
    "license": "MIT",
    "author": "Dany Castillo",
    "repository": {
        "type": "git",
        "url": "https://github.com/dcastil/tailwind-merge.git",
        "directory": "packages/vite"
    },
    "homepage": "https://github.com/dcastil/tailwind-merge",
    "bugs": {
        "url": "https://github.com/dcastil/tailwind-merge/issues"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./runtime": "./src/runtime.ts",
        "./tailwind-merge": "./src/tailwind-merge.ts"
    },
    "files": [
        "dist",
        "src"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "exports": {
            ".": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "./runtime": {
                "types": "./dist/runtime.d.mts",
                "default": "./dist/runtime.mjs"
            },
            "./tailwind-merge": {
                "types": "./dist/tailwind-merge.d.mts",
                "default": "./dist/tailwind-merge.mjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "lint": "eslint --max-warnings 0 .",
        "test": "vitest --no-watch",
        "test:watch": "vitest",
        "test:types": "tsc --noEmit",
        "test:exports": "node scripts/test-packed-package.mjs",
        "version": "node ../../scripts/update-pinned-links.mjs"
    },
    "peerDependencies": {
        "@tailwindcss/vite": "~4.3.3",
        "tailwindcss": "~4.3.3",
        "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
    },
    "peerDependenciesMeta": {
        "@tailwindcss/vite": {
            "optional": true
        }
    },
    "dependencies": {
        "@tailwindcss/node": "~4.3.3",
        "tailwind-merge": "workspace:*"
    },
    "devDependencies": {
        "@tailwindcss/vite": "~4.3.3",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "tailwind-merge-configurator": "workspace:*",
        "tailwindcss": "~4.3.3",
        "tsdown": "^0.22.14",
        "typescript": "catalog:",
        "vite": "^7.3.3",
        "vitest": "catalog:"
    }
}
