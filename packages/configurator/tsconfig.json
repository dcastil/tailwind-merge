{
    "compilerOptions": {
        // Type Checking — mirrors the root tsconfig so shared source files compile identically
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "strict": true,
        // Modules
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // Relative imports in src/ carry explicit .ts extensions and type-only imports are explicitly marked, so the CLI runs directly under Node's built-in type stripping (`node src/cli.ts`) without a build or loader. The type-marking half of that contract is enforced by the consistent-type-imports lint rule (verbatimModuleSyntax would be the compiler-level equivalent, but it would also apply to the library sources reached through the paths mapping below, which don't follow it).
        "allowImportingTsExtensions": true,
        // Maps the package name to the library source so type-checking works without a prior `pnpm build` (the published types live in dist/). Runtime resolution in tests goes through the pnpm workspace link instead.
        "paths": {
            "tailwind-merge": ["../tailwind-merge/src/index.ts"],
            "tailwind-merge/unstable-do-not-import": [
                "../tailwind-merge/src/unstable-do-not-import.ts"
            ]
        },
        // Emit
        "noEmit": true,
        // @tailwindcss/node ships type declarations whose relative imports don't resolve under Bundler module resolution. The configurator only uses small structurally-typed slices of that API, so skipping lib checks is safe.
        "skipLibCheck": true,
        "types": ["node"],
        // Interop Constraints
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        // Language and Environment
        "target": "ESNext"
    },
    "include": ["src/**/*", "tests/**/*"]
}
