{
    "compilerOptions": {
        // Type Checking — mirrors the root tsconfig so shared source files compile identically
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "strict": true,
        // Modules
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // Relative imports carry explicit .ts extensions like the configurator's, whose sources are reached through the workspace link and the paths mapping below.
        "allowImportingTsExtensions": true,
        // Maps the library name to workspace source so type-checking works without a prior build (the published types live in dist/). Runtime resolution in tests goes through the pnpm workspace link instead.
        "paths": {
            "tailwind-merge": ["../tailwind-merge/src/index.ts"],
            "tailwind-merge/unstable-do-not-import": [
                "../tailwind-merge/src/unstable-do-not-import.ts"
            ]
        },
        // Emit
        "noEmit": true,
        // @tailwindcss/node ships type declarations whose relative imports don't resolve under Bundler module resolution. This package only touches small slices of that API, so skipping lib checks is safe.
        "skipLibCheck": true,
        "types": ["node"],
        // Interop Constraints
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        // Language and Environment
        "target": "ESNext"
    },
    "include": ["src/**/*", "tests/**/*"],
    // Fixture copies of test runs are exercised by running them, not by this tsconfig, and may be mid-write while a check runs.
    "exclude": ["tests/fixtures", "tests/.tmp-*"]
}
